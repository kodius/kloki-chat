# Fastlane secrets — copy to `fastlane/.env` and fill in.
# This file (.env.example) IS committed. `fastlane/.env` is gitignored.
#
# Only deploy credentials belong here. The app has no build-time config:
# every build talks to the production Kloki servers.

# App Store Connect API key. Create at:
# https://appstoreconnect.apple.com -> Users and Access -> Integrations -> App Store Connect API
# Role: App Manager. Download the .p8 once (it cannot be re-downloaded).
# The same key as kloki-mobile works, both apps are on the same team.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=

# Google Play service account JSON key. Create at:
# Google Play Console -> Setup -> API access -> Create new service account
# Grant it "Release manager" on this app, then download the JSON key.
# Used for the upload, for the version code lookup and for reading which
# languages the listing has (release notes go to each of them).
GOOGLE_PLAY_JSON_KEY_PATH=

# The Android upload keystore is NOT configured here: the build reads
# `android/release-keystore.properties`, the same file a manual
# `flutter build appbundle -Psigned` uses. See docs/konvo/release.md.
